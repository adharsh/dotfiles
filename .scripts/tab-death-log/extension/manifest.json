{
  "manifest_version": 3,
  "name": "Tab death log",
  "version": "1.0",
  "description": "Logs the address of each tab whose page process dies, for browser-tab-watchdog.",
  "key": "",
  "permissions": ["nativeMessaging", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
