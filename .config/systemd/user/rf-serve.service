[Unit]
Description=research-feed: the app, live at http://127.0.0.1:8780 (rf serve)

[Service]
WorkingDirectory=%h/workspace/research-feed
# systemd starts with a bare PATH; uv lives in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Print each save as it happens, so the journal shows them in order.
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/uv run rf serve
# If it ever stops (or the port is still taken), try again a few seconds later.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
