#!/usr/bin/env bash
set -euo pipefail

# Configuration (override via environment or systemd Environment=)
THRESHOLD_MB="${WATCHDOG_THRESHOLD_MB:-1024}"
THRESHOLD_KB=$((THRESHOLD_MB * 1024))
DRY_RUN="${WATCHDOG_DRY_RUN:-false}"
COOLDOWN_FILE="${XDG_RUNTIME_DIR:-/tmp}/browser-watchdog-cooldown"
COOLDOWN_SEC=60
KILL_LOG="${WATCHDOG_KILL_LOG:-${HOME}/.local/share/browser-tab-watchdog/kills.jsonl}"
# Brave tabs whose page process died, with their address, as logged by the extension in .scripts/tab-death-log.
DEATH_LOG="${WATCHDOG_DEATH_LOG:-${HOME}/.local/share/browser-tab-watchdog/tab-deaths.jsonl}"
CLK_TCK=$(getconf CLK_TCK)

now=$(date +%s)
mkdir -p "$(dirname "$KILL_LOG")"

# Prune stale cooldown entries
if [[ -f "$COOLDOWN_FILE" ]]; then
    tmp=$(mktemp)
    while IFS=: read -r pid ts; do
        if (( now - ts < 120 )); then
            printf '%s:%s\n' "$pid" "$ts" >> "$tmp"
        fi
    done < "$COOLDOWN_FILE"
    mv "$tmp" "$COOLDOWN_FILE"
fi

# Check if PID is in cooldown
in_cooldown() {
    [[ -f "$COOLDOWN_FILE" ]] || return 1
    while IFS=: read -r cpid ts; do
        if [[ "$cpid" == "$1" ]] && (( now - ts < COOLDOWN_SEC )); then
            return 0
        fi
    done < "$COOLDOWN_FILE"
    return 1
}

# Read memory in KB for a given PID (PSS preferred, RSS fallback)
read_memory_kb() {
    local pid=$1
    # Try PSS from smaps_rollup (more accurate for shared-memory processes)
    local pss
    pss=$(awk '/^Pss:/{s+=$2} END{print s+0}' "/proc/$pid/smaps_rollup" 2>/dev/null) || true
    if [[ -n "$pss" && "$pss" -gt 0 ]]; then
        echo "$pss"
        return
    fi
    # Fallback to RSS
    awk '/^VmRSS:/{print $2}' "/proc/$pid/status" 2>/dev/null || echo 0
}

# A process's memory in MB, as "pss anon file shmem swap": its PSS split by kind, then what it has in swap.
memory_breakdown() {
    awk '/^Pss:/{p=$2} /^Pss_Anon:/{a=$2} /^Pss_File:/{f=$2} /^Pss_Shmem:/{s=$2} /^Swap:/{w=$2}
         END{printf "%d %d %d %d %d\n", p/1024, a/1024, f/1024, s/1024, w/1024}' "/proc/$1/smaps_rollup" 2>/dev/null
}

# CPU seconds a process has used, in user and kernel mode together.
cpu_seconds() {
    awk -v hz="$CLK_TCK" '{printf "%.1f\n", ($14 + $15) / hz}' "/proc/$1/stat" 2>/dev/null
}

# The whole system's memory in MB, as "total available swap_used".
system_memory() {
    awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
         END{printf "%d %d %d\n", t/1024, a/1024, (st-sf)/1024}' /proc/meminfo
}

# Match the browser executable, rather than browser names elsewhere in the arguments.
browser_name() {
    local executable=""
    # The process may exit between pgrep and here; the braces silence the failed redirect.
    { IFS= read -r -d '' executable < "/proc/$1/cmdline"; } 2>/dev/null || true
    # Renderers rewrite their cmdline as one space-joined string, so take the first word.
    executable=${executable%% *}
    [[ -n "$executable" ]] || return 1
    case "$executable" in
        # Chrome's main process keeps its launcher path in argv[0].
        /opt/google/chrome/chrome|/opt/google/chrome/google-chrome|/usr/bin/google-chrome|/usr/bin/google-chrome-stable) echo "Chrome" ;;
        /opt/brave.com/brave/brave) echo "Brave" ;;
        *) return 1 ;;
    esac
}

# Process age in seconds (from /proc/pid/stat starttime vs system uptime)
process_age() {
    local pid=$1
    local start_ticks
    start_ticks=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || { echo 0; return; }
    local uptime_sec
    uptime_sec=$(awk '{printf "%d", $1}' /proc/uptime)
    echo $(( uptime_sec - start_ticks / CLK_TCK ))
}

# Total memory for this browser (all of this user's processes) in MB.
total_browser_mb() {
    local browser=$1
    local total=0
    local p
    for p in $(pgrep -u "$UID" -f 'chrome|brave' 2>/dev/null || true); do
        [[ "$(browser_name "$p")" == "$browser" ]] || continue
        local kb
        kb=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null) || continue
        (( total += kb )) || true
    done
    echo $(( total / 1024 ))
}

# Find this user's Chrome and Brave page renderers, excluding extensions.
pids=()
declare -A renderer_counts=([Chrome]=0 [Brave]=0)
while read -r pid; do
    browser=$(browser_name "$pid") || continue
    cmdline=$(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline") || continue
    [[ "$cmdline" == *--extension-process* ]] && continue
    pids+=("$pid")
    renderer_counts[$browser]=$((renderer_counts[$browser] + 1))
done < <(pgrep -u "$UID" -f -- '(^| )--type=renderer( |$)' 2>/dev/null || true)

if [[ ${#pids[@]} -eq 0 ]]; then
    exit 0
fi

records=()
brave_killed=false
for pid in "${pids[@]}"; do
    [[ -d "/proc/$pid" ]] || continue
    browser=$(browser_name "$pid") || continue

    # Skip extension renderer processes
    cmdline=$(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline") || continue
    [[ " $cmdline " == *" --type=renderer "* ]] || continue
    [[ "$cmdline" == *--extension-process* ]] && continue

    mem_kb=$(read_memory_kb "$pid")
    mem_mb=$((mem_kb / 1024))

    if (( mem_kb > THRESHOLD_KB )); then
        if in_cooldown "$pid"; then
            continue
        fi

        instance="$browser"
        if [[ "$browser" == "Chrome" && "$cmdline" == *dev-profile* ]]; then
            instance="Dev Chrome"
        fi

        # Measure the tab and the system before the kill, since the tab's /proc entry goes with it.
        age=$(process_age "$pid")
        pss_mb=0 anon_mb=0 file_mb=0 shmem_mb=0 swap_mb=0 mem_total_mb=0 mem_available_mb=0 swap_used_mb=0
        read -r pss_mb anon_mb file_mb shmem_mb swap_mb < <(memory_breakdown "$pid") || true
        cpu_s=$(cpu_seconds "$pid") || true
        cpu_s=${cpu_s:-0}
        read -r mem_total_mb mem_available_mb swap_used_mb < <(system_memory) || true
        record=$(jq -nc \
            --arg timestamp "$(date -Iseconds)" \
            --argjson pid "$pid" \
            --arg browser "$browser" \
            --arg instance "$instance" \
            --argjson threshold_mb "$THRESHOLD_MB" \
            --argjson memory_mb "${pss_mb:-0}" \
            --argjson pss_anon_mb "${anon_mb:-0}" \
            --argjson pss_file_mb "${file_mb:-0}" \
            --argjson pss_shmem_mb "${shmem_mb:-0}" \
            --argjson swap_mb "${swap_mb:-0}" \
            --argjson age_seconds "$age" \
            --argjson cpu_seconds "$cpu_s" \
            --argjson cpu_avg_percent "$(awk -v c="$cpu_s" -v a="$age" 'BEGIN{printf "%.1f", (a > 0 ? 100 * c / a : 0)}')" \
            --argjson renderer_count "${renderer_counts[$browser]}" \
            --argjson total_browser_mb "$(total_browser_mb "$browser")" \
            --argjson system_mem_total_mb "${mem_total_mb:-0}" \
            --argjson system_mem_available_mb "${mem_available_mb:-0}" \
            --argjson system_swap_used_mb "${swap_used_mb:-0}" \
            '$ARGS.named')

        if [[ "$DRY_RUN" == "true" ]]; then
            echo "[browser-tab-watchdog] DRY RUN: would kill PID $pid (${mem_mb}MB) [$instance] $record"
            continue
        fi

        echo "[browser-tab-watchdog] Killing PID $pid (${mem_mb}MB PSS) [$instance]"
        killed_at_ms=$(date +%s%3N)
        kill -TERM "$pid" 2>/dev/null || true
        records+=("$(jq -c --argjson ms "$killed_at_ms" '. + {killed_at_ms: $ms}' <<< "$record")")
        [[ "$browser" == "Brave" ]] && brave_killed=true

        printf '%s:%s\n' "$pid" "$now" >> "$COOLDOWN_FILE"
    fi
done

(( ${#records[@]} > 0 )) || exit 0

# Give the Brave extension time to log which tabs died: it checks a tab 3 s after its page process goes.
[[ "$brave_killed" == "true" ]] && sleep 6

for record in "${records[@]}"; do
    # Attach the tabs whose page process went just after this kill. Several tabs can share one process,
    # and a Chrome tab, or a page the extension does not run in, gives none.
    tabs='[]'
    if [[ "$(jq -r .browser <<< "$record")" == "Brave" && -f "$DEATH_LOG" ]]; then
        tabs=$(tail -n 200 "$DEATH_LOG" | jq -sc --argjson ms "$(jq .killed_at_ms <<< "$record")" \
            '[.[] | select(.port_closed_ms >= $ms - 1000 and .port_closed_ms <= $ms + 5000)]' 2>/dev/null) || tabs='[]'
    fi
    record=$(jq -c --argjson tabs "$tabs" '. + {tabs: $tabs}' <<< "$record")
    printf '%s\n' "$record" >> "$KILL_LOG"

    browser=$(jq -r .browser <<< "$record")
    case "$browser" in
        Chrome) browser_icon=/opt/google/chrome/product_logo_64.png ;;
        Brave) browser_icon=/opt/brave.com/brave/product_logo_64.png ;;
    esac
    icon_flag=()
    [[ -f "$browser_icon" ]] && icon_flag=(--icon "$browser_icon")
    notify-send --urgency=critical --app-name=browser-tab-watchdog "${icon_flag[@]}" \
        "$(jq -r '"\(.browser) Tab Killed (\(.memory_mb)MB)"' <<< "$record")" \
        "$(jq -r '(if .tabs == [] then "PID \(.pid), no tab address logged" else
                    [.tabs[] | "\(.url | sub("^[a-z-]+://"; "") | sub("[/?#].*"; "")): \(.title)"] | join("\n") end)
                  + "\nInstance: \(.instance), CPU \(.cpu_avg_percent)% over \(.age_seconds / 60 | floor) min"' <<< "$record")"
done

echo "[browser-tab-watchdog] Killed ${#records[@]} tab(s) exceeding ${THRESHOLD_MB}MB"
